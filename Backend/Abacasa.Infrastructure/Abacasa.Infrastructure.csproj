<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
		<!-- Pinned so every Microsoft.IdentityModel.* package resolves to the same version (JwtBearer only requires >= 8.19.2) -->
		<PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Abacasa.Application\Abacasa.Application.csproj" />
		<ProjectReference Include="..\Abacasa.Domain\Abacasa.Domain.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Resources\tr.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\en.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>